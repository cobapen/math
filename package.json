{
  "name": "@cobapen/math",
  "version": "0.1.1",
  "description": "math render lib",
  "license": "MIT",
  "author": "yamavol",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "engines": {
    "node": ">=20.11.0 <21 || >=21.2.0"
  },
  "scripts": {
    "build": "tsc",
    "build:dev": "tsc --build tsconfig.dev.json",
    "build:doc": "npm run build && node docs/build.js",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@mathjax/mathjax-bbm-font-extension": "^4.1.0",
    "@mathjax/mathjax-bboldx-font-extension": "^4.1.0",
    "@mathjax/mathjax-dsfont-font-extension": "^4.1.0",
    "@mathjax/mathjax-mhchem-font-extension": "^4.1.0",
    "@mathjax/src": "^4.1.0"
  },
  "devDependencies": {
    "@cobapen/eslint-config": "^0.5.1",
    "@types/mustache": "^4.2.6",
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
